#!/usr/bin/env bash

set -euo pipefail

PROGRAM="${0##*/}"
REF_PREFIX="refs/worktree-snapshots"
DEFAULT_TTL_DAYS=30
DEFAULT_IDENT_NAME="context-kit wt-snapshot"
DEFAULT_IDENT_EMAIL="wt-snapshot@context-kit.invalid"
PAYLOAD_PATH="wt-snapshot.payload.tar"
MANIFEST_PATH="wt-snapshot.manifest"
EX_USAGE=64
EX_GIT=70
NULL_OID=0000000000000000000000000000000000000000

TMP_DIR=""
WORKTREE_ROOT=""
WORKTREE_GIT_DIR=""
HEAD_COMMIT=""
WORKTREE_NAME=""
REF_WORKTREE_NAME=""
IDENT_NAME=""
IDENT_EMAIL=""
GIT_ENV_BASE=()
GIT_CTX_ARGS=()
GIT_CONFIG_ARGS=()
SCAN_COMMAND="${CK_WTSNAP_SECRET_SCAN_CMD:-}"

cleanup() {
  if [ -n "${TMP_DIR}" ] && [ -d "${TMP_DIR}" ]; then
    rm -rf "${TMP_DIR}"
  fi
}
trap cleanup EXIT

usage() {
  cat >&2 <<EOF
usage: ${PROGRAM} [restore <ref> <target-dir> | prune]
EOF
}

say() {
  printf '%s\n' "$*"
}

err() {
  printf '%s: %s\n' "${PROGRAM}" "$*" >&2
}

die_usage() {
  err "$*"
  usage
  exit "${EX_USAGE}"
}

die_runtime() {
  err "$*"
  exit "${EX_GIT}"
}

git_fail() {
  err "$*"
  exit "${EX_GIT}"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "${value}"
}

coerce_numeric_or_default() {
  local value="$1"
  local fallback="$2"

  case "${value}" in
    ''|*[!0-9]*)
      printf '%s\n' "${fallback}"
      ;;
    *)
      printf '%s\n' "${value}"
      ;;
  esac
}

parse_ident() {
  local raw="${CK_WTSNAP_IDENT:-}"

  IDENT_NAME="${DEFAULT_IDENT_NAME}"
  IDENT_EMAIL="${DEFAULT_IDENT_EMAIL}"

  if [ -z "${raw}" ]; then
    return
  fi

  if [[ "${raw}" =~ ^(.*)[[:space:]]\<([^<>[:space:]]+)\>[[:space:]]*$ ]]; then
    IDENT_NAME="$(trim "${BASH_REMATCH[1]}")"
    IDENT_EMAIL="${BASH_REMATCH[2]}"
  elif [[ "${raw}" == *:* ]]; then
    IDENT_NAME="$(trim "${raw%%:*}")"
    IDENT_EMAIL="$(trim "${raw#*:}")"
  else
    IDENT_NAME="$(trim "${raw}")"
  fi

  [ -n "${IDENT_NAME}" ] || IDENT_NAME="${DEFAULT_IDENT_NAME}"
  [ -n "${IDENT_EMAIL}" ] || IDENT_EMAIL="${DEFAULT_IDENT_EMAIL}"
}

build_git_env() {
  GIT_ENV_BASE=(
    "GIT_CONFIG_NOSYSTEM=1"
    "GIT_CONFIG_SYSTEM=/dev/null"
    "GIT_CONFIG_GLOBAL=/dev/null"
    "GIT_ATTR_NOSYSTEM=1"
    "GIT_OPTIONAL_LOCKS=0"
    "GIT_PAGER=cat"
    "GIT_EXTERNAL_DIFF="
    "GIT_TERMINAL_PROMPT=0"
    "GIT_AUTHOR_NAME=${IDENT_NAME}"
    "GIT_AUTHOR_EMAIL=${IDENT_EMAIL}"
    "GIT_COMMITTER_NAME=${IDENT_NAME}"
    "GIT_COMMITTER_EMAIL=${IDENT_EMAIL}"
  )
  GIT_CONFIG_ARGS=(
    -c core.fsmonitor=false
    -c core.hooksPath=/dev/null
    -c core.attributesFile=/dev/null
    -c core.excludesFile=/dev/null
    -c commit.gpgSign=false
    -c tag.gpgSign=false
    -c credential.helper=
  )
}

git_base() {
  env \
    -u GIT_DIR \
    -u GIT_WORK_TREE \
    -u GIT_INDEX_FILE \
    -u GIT_CONFIG_PARAMETERS \
    -u GIT_CONFIG_COUNT \
    "${GIT_ENV_BASE[@]}" \
    git "${GIT_CONFIG_ARGS[@]}" "$@"
}

git_maybe() {
  git_base "${GIT_CTX_ARGS[@]}" "$@"
}

git_run() {
  if ! git_maybe "$@"; then
    git_fail "git $* failed"
  fi
}

git_capture() {
  local __var_name="$1"
  shift
  local output=""

  if ! output=$(git_maybe "$@" 2>"${TMP_DIR}/git.err"); then
    local detail=""
    if [ -s "${TMP_DIR}/git.err" ]; then
      detail=$(tr '\n' ' ' < "${TMP_DIR}/git.err")
      detail=$(trim "${detail}")
    fi
    if [ -n "${detail}" ]; then
      git_fail "git $* failed: ${detail}"
    fi
    git_fail "git $* failed"
  fi
  printf -v "${__var_name}" '%s' "${output}"
}

git_to_file() {
  local dest="$1"
  shift
  if ! git_maybe "$@" >"${dest}" 2>"${TMP_DIR}/git.err"; then
    local detail=""
    if [ -s "${TMP_DIR}/git.err" ]; then
      detail=$(tr '\n' ' ' < "${TMP_DIR}/git.err")
      detail=$(trim "${detail}")
    fi
    if [ -n "${detail}" ]; then
      git_fail "git $* failed: ${detail}"
    fi
    git_fail "git $* failed"
  fi
}

with_temp_index_maybe() {
  local index_file="$1"
  shift
  env \
    -u GIT_DIR \
    -u GIT_WORK_TREE \
    -u GIT_CONFIG_PARAMETERS \
    -u GIT_CONFIG_COUNT \
    "${GIT_ENV_BASE[@]}" \
    "GIT_INDEX_FILE=${index_file}" \
    git "${GIT_CONFIG_ARGS[@]}" "${GIT_CTX_ARGS[@]}" "$@"
}

with_temp_index_run() {
  local index_file="$1"
  shift
  if ! with_temp_index_maybe "${index_file}" "$@"; then
    git_fail "git $* failed with temporary index"
  fi
}

with_temp_index_capture() {
  local __var_name="$1"
  local index_file="$2"
  shift 2
  local output=""
  if ! output=$(with_temp_index_maybe "${index_file}" "$@" 2>"${TMP_DIR}/git.err"); then
    local detail=""
    if [ -s "${TMP_DIR}/git.err" ]; then
      detail=$(tr '\n' ' ' < "${TMP_DIR}/git.err")
      detail=$(trim "${detail}")
    fi
    if [ -n "${detail}" ]; then
      git_fail "git $* failed with temporary index: ${detail}"
    fi
    git_fail "git $* failed with temporary index"
  fi
  printf -v "${__var_name}" '%s' "${output}"
}

discover_repo_context() {
  git_capture WORKTREE_ROOT rev-parse --show-toplevel
  git_capture WORKTREE_GIT_DIR rev-parse --absolute-git-dir
  git_capture HEAD_COMMIT rev-parse HEAD
  WORKTREE_NAME=$(basename "${WORKTREE_ROOT}")
  REF_WORKTREE_NAME=$(printf '%s' "${WORKTREE_NAME}" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-')
  REF_WORKTREE_NAME="${REF_WORKTREE_NAME#-}"
  REF_WORKTREE_NAME="${REF_WORKTREE_NAME%-}"
  [ -n "${REF_WORKTREE_NAME}" ] || REF_WORKTREE_NAME="worktree"
  GIT_CTX_ARGS=(-C "${WORKTREE_ROOT}" --git-dir="${WORKTREE_GIT_DIR}" --work-tree="${WORKTREE_ROOT}")
}

ensure_tmp_dir() {
  TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/wt-snapshot.XXXXXX")
}

utc_ref_timestamp() {
  TZ=UTC date '+%Y%m%dT%H%M%SZ'
}

utc_manifest_timestamp() {
  TZ=UTC date '+%Y-%m-%dT%H:%M:%SZ'
}

candidate_exists() {
  local rel_path="$1"
  local abs_path="${WORKTREE_ROOT}/${rel_path}"
  [ -e "${abs_path}" ] || [ -L "${abs_path}" ]
}

append_existing_tracked_paths() {
  local dest="$1"
  local raw="${TMP_DIR}/tracked.raw"

  : > "${dest}"
  git_to_file "${raw}" ls-files -z --cached
  while IFS= read -r -d '' rel_path; do
    if candidate_exists "${rel_path}"; then
      printf '%s\0' "${rel_path}" >> "${dest}"
    fi
  done < "${raw}"
}

append_ls_files_output() {
  local dest="$1"
  shift
  local raw="${TMP_DIR}/ls-files.$RANDOM"

  if ! git_maybe "$@" >"${raw}" 2>"${TMP_DIR}/git.err"; then
    local detail=""
    if [ -s "${TMP_DIR}/git.err" ]; then
      detail=$(tr '\n' ' ' < "${TMP_DIR}/git.err")
      detail=$(trim "${detail}")
    fi
    if [ -n "${detail}" ]; then
      git_fail "git $* failed: ${detail}"
    fi
    git_fail "git $* failed"
  fi
  cat "${raw}" >> "${dest}"
}

parse_ignored_specs() {
  local raw="${CK_WTSNAP_INCLUDE_IGNORED:-}"
  local item=""
  IGNORED_PATHSPECS=()

  if [ -z "${raw}" ]; then
    return
  fi

  IFS=',:' read -r -a items <<< "${raw}"
  for item in "${items[@]}"; do
    item=$(trim "${item}")
    if [ -n "${item}" ]; then
      IGNORED_PATHSPECS+=(":(glob)${item}")
    fi
  done
}

collect_candidate_paths() {
  TRACKED_ARCHIVE_LIST="${TMP_DIR}/tracked.archive"
  UNTRACKED_LIST="${TMP_DIR}/untracked.list"
  IGNORED_LIST="${TMP_DIR}/ignored.list"
  ARCHIVE_LIST="${TMP_DIR}/archive.list"

  append_existing_tracked_paths "${TRACKED_ARCHIVE_LIST}"
  : > "${UNTRACKED_LIST}"
  append_ls_files_output "${UNTRACKED_LIST}" ls-files -z --others --exclude-standard

  : > "${IGNORED_LIST}"
  parse_ignored_specs
  if [ "${#IGNORED_PATHSPECS[@]}" -gt 0 ]; then
    append_ls_files_output "${IGNORED_LIST}" ls-files -z --others --ignored --exclude-standard -- "${IGNORED_PATHSPECS[@]}"
  fi

  cat "${TRACKED_ARCHIVE_LIST}" "${UNTRACKED_LIST}" "${IGNORED_LIST}" > "${ARCHIVE_LIST}"
}

is_tracked_dirty() {
  local rc=0
  if git_maybe diff --quiet --ignore-submodules=all HEAD --; then
    return 1
  else
    rc=$?
  fi

  if [ "${rc}" -eq 1 ]; then
    return 0
  fi

  git_fail "git diff --quiet --ignore-submodules=all HEAD -- failed"
}

head_reachable_from_any_ref() {
  local refs=""
  git_capture refs for-each-ref --format='%(refname)' --contains "${HEAD_COMMIT}"
  [ -n "${refs}" ]
}

path_count() {
  local file="$1"
  local count=0
  while IFS= read -r -d '' _path; do
    count=$((count + 1))
  done < "${file}"
  printf '%s\n' "${count}"
}

scan_candidate_path() {
  local scan_root="$1"
  local rel_path="$2"
  local abs_path="${scan_root}/${rel_path}"
  local rc=0

  if [ -z "${SCAN_COMMAND}" ]; then
    return 0
  fi

  if [ -L "${abs_path}" ]; then
    local target=""
    target=$(readlink "${abs_path}" 2>/dev/null || true)
    if printf '%s' "${target}" | bash -c "${SCAN_COMMAND}"; then
      return 0
    else
      rc=$?
    fi
  elif [ -f "${abs_path}" ]; then
    if bash -c "${SCAN_COMMAND}" < "${abs_path}"; then
      return 0
    else
      rc=$?
    fi
  else
    return 0
  fi

  if [ "${rc}" -ne 0 ]; then
    printf '%s: secret scan failed for %q\n' "${PROGRAM}" "${rel_path}" >&2
    exit "${rc}"
  fi
}

scan_payload_archive() {
  local payload_file="$1"
  local scan_root="${TMP_DIR}/scan-root"
  local rel_path=""
  mkdir -p "${scan_root}"
  if ! tar -xf "${payload_file}" -C "${scan_root}"; then
    die_runtime "failed to extract snapshot payload for scanning"
  fi
  while IFS= read -r -d '' rel_path; do
    scan_candidate_path "${scan_root}" "${rel_path}"
  done < "${ARCHIVE_LIST}"
}

create_payload_archive() {
  local payload_file="$1"

  if ! tar -cf "${payload_file}" -C "${WORKTREE_ROOT}" --null -T "${ARCHIVE_LIST}"; then
    die_runtime "failed to create snapshot payload archive"
  fi
}

manifest_value() {
  local key="$1"
  local file="$2"
  sed -n "s/^${key}=//p" "${file}" | head -n 1
}

create_snapshot_ref() {
  local timestamp="$1"
  local payload_file="$2"
  local ref_name="${REF_PREFIX}/${REF_WORKTREE_NAME}/${timestamp}"
  local manifest_file="${TMP_DIR}/manifest.txt"
  local index_file="${TMP_DIR}/index"
  local payload_oid=""
  local manifest_oid=""
  local tree_oid=""
  local commit_oid=""
  local tracked_count=""
  local untracked_count=""
  local ignored_count=""
  local created_at=""
  local commit_message=""

  tracked_count=$(path_count "${TRACKED_ARCHIVE_LIST}")
  untracked_count=$(path_count "${UNTRACKED_LIST}")
  ignored_count=$(path_count "${IGNORED_LIST}")
  created_at=$(utc_manifest_timestamp)

  cat > "${manifest_file}" <<EOF
version=1
created_at=${created_at}
ref_name=${ref_name}
worktree_name=${WORKTREE_NAME}
ref_worktree_name=${REF_WORKTREE_NAME}
head_commit=${HEAD_COMMIT}
tracked_entries=${tracked_count}
untracked_entries=${untracked_count}
ignored_entries=${ignored_count}
ignored_globs=${CK_WTSNAP_INCLUDE_IGNORED:-}
payload_path=${PAYLOAD_PATH}
EOF

  with_temp_index_run "${index_file}" read-tree --empty
  with_temp_index_capture payload_oid "${index_file}" hash-object -w "${payload_file}"
  with_temp_index_capture manifest_oid "${index_file}" hash-object -w "${manifest_file}"
  with_temp_index_run "${index_file}" update-index --add --cacheinfo 100644 "${payload_oid}" "${PAYLOAD_PATH}"
  with_temp_index_run "${index_file}" update-index --add --cacheinfo 100644 "${manifest_oid}" "${MANIFEST_PATH}"
  with_temp_index_capture tree_oid "${index_file}" write-tree

  commit_message=$(
    cat <<EOF
wt-snapshot: preserve ${WORKTREE_NAME} at ${timestamp}

worktree=${WORKTREE_NAME}
head=${HEAD_COMMIT}
tracked_entries=${tracked_count}
untracked_entries=${untracked_count}
ignored_entries=${ignored_count}
EOF
  )

  with_temp_index_capture commit_oid "${index_file}" commit-tree "${tree_oid}" -p "${HEAD_COMMIT}" -m "${commit_message}"
  if ! git_maybe update-ref "${ref_name}" "${commit_oid}" "${NULL_OID}" 2>"${TMP_DIR}/git.err"; then
    local detail=""
    if [ -s "${TMP_DIR}/git.err" ]; then
      detail=$(tr '\n' ' ' < "${TMP_DIR}/git.err")
      detail=$(trim "${detail}")
    fi
    case "${detail}" in
      *"reference already exists"*|*"cannot lock ref"*)
        return 2
        ;;
      "")
        git_fail "git update-ref ${ref_name} failed"
        ;;
      *)
        git_fail "git update-ref ${ref_name} failed: ${detail}"
        ;;
    esac
  fi
  say "snapshot created: ${ref_name} ${commit_oid}"
}

restore_snapshot() {
  local ref="$1"
  local target_dir="$2"
  local manifest_tmp="${TMP_DIR}/restore.manifest"
  local payload_tmp="${TMP_DIR}/restore.tar"
  local version=""
  local payload_path=""

  if [ -e "${target_dir}" ] && [ ! -d "${target_dir}" ]; then
    die_runtime "restore target exists and is not a directory: ${target_dir}"
  fi
  if [ -d "${target_dir}" ] && find "${target_dir}" -mindepth 1 -print -quit | grep -q .; then
    die_runtime "restore target must be empty: ${target_dir}"
  fi

  if ! git_maybe cat-file -e "${ref}^{commit}" >/dev/null 2>"${TMP_DIR}/git.err"; then
    git_fail "snapshot ref not found: ${ref}"
  fi
  git_to_file "${manifest_tmp}" show "${ref}:${MANIFEST_PATH}"
  version=$(manifest_value version "${manifest_tmp}")
  payload_path=$(manifest_value payload_path "${manifest_tmp}")

  if [ "${version}" != "1" ] || [ "${payload_path}" != "${PAYLOAD_PATH}" ]; then
    die_runtime "unsupported snapshot manifest in ${ref}"
  fi

  mkdir -p "${target_dir}"
  git_to_file "${payload_tmp}" show "${ref}:${PAYLOAD_PATH}"
  if ! tar -xf "${payload_tmp}" -C "${target_dir}"; then
    die_runtime "failed to restore ${ref} into ${target_dir}"
  fi
  say "restored ${ref} -> ${target_dir}"
}

timestamp_to_epoch() {
  local timestamp="$1"

  if date -j -u -f '%Y%m%dT%H%M%SZ' "${timestamp}" '+%s' >/dev/null 2>&1; then
    date -j -u -f '%Y%m%dT%H%M%SZ' "${timestamp}" '+%s'
  else
    date -u -d "${timestamp}" '+%s'
  fi
}

list_expired_refs() {
  local ttl_days
  local now_epoch
  local cutoff
  local refs_file="${TMP_DIR}/prune.refs"
  local listed=0

  ttl_days=$(coerce_numeric_or_default "${CK_WTSNAP_TTL_DAYS:-}" "${DEFAULT_TTL_DAYS}")
  now_epoch=$(date -u '+%s')
  cutoff=$((now_epoch - (ttl_days * 86400)))

  git_to_file "${refs_file}" for-each-ref --format='%(refname)' "${REF_PREFIX}"
  while IFS= read -r ref_name; do
    [ -n "${ref_name}" ] || continue
    local ts="${ref_name##*/}"
    local epoch=""
    if ! epoch=$(timestamp_to_epoch "${ts}" 2>/dev/null); then
      continue
    fi
    if [ "${epoch}" -lt "${cutoff}" ]; then
      listed=1
      say "${ref_name}"
    fi
  done < "${refs_file}"

  if [ "${listed}" -eq 0 ]; then
    say "no expired snapshot refs"
  fi
}

run_snapshot() {
  local timestamp=""
  local ref_name=""
  local payload_file="${TMP_DIR}/payload.tar"

  collect_candidate_paths

  if ! is_tracked_dirty &&
     [ ! -s "${UNTRACKED_LIST}" ] &&
     [ ! -s "${IGNORED_LIST}" ] &&
     head_reachable_from_any_ref; then
    say "no-op: HEAD is already reachable and there is nothing to snapshot"
    return 0
  fi

  create_payload_archive "${payload_file}"
  scan_payload_archive "${payload_file}"

  while :; do
    local create_rc=0
    timestamp=$(utc_ref_timestamp)
    ref_name="${REF_PREFIX}/${REF_WORKTREE_NAME}/${timestamp}"
    if git_maybe show-ref --verify --quiet "${ref_name}"; then
      sleep 1
      continue
    fi
    if create_snapshot_ref "${timestamp}" "${payload_file}"; then
      break
    fi
    create_rc=$?
    if [ "${create_rc}" -eq 2 ]; then
      sleep 1
      continue
    fi
    break
  done
}

main() {
  ensure_tmp_dir
  parse_ident
  build_git_env
  discover_repo_context

  case "${1:-}" in
    '')
      run_snapshot
      ;;
    restore)
      [ $# -eq 3 ] || die_usage "restore requires <ref> <target-dir>"
      restore_snapshot "$2" "$3"
      ;;
    prune)
      [ $# -eq 1 ] || die_usage "prune takes no additional arguments"
      list_expired_refs
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die_usage "unknown subcommand: $1"
      ;;
  esac
}

main "$@"
